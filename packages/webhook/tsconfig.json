{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // Required by the tsup DTS build, not our own options: rollup-plugin-dts
    // injects a `baseUrl` into the compiler options, which TypeScript 6 reports
    // as the TS5101 deprecation *error*. `tsc --noEmit` passes without this
    // (we set no deprecated options ourselves), but `pnpm build` fails without
    // it. Revisit when tsup stops injecting `baseUrl` or on the TS 7 migration.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
