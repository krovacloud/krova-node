{
  "name": "n8n-nodes-krova",
  "version": "0.2.0",
  "description": "n8n community node for Krova Cloud — create, start, power off, restart, list, and delete Cubes (Firecracker microVMs), manage domains, snapshots and TCP mappings, and read regions, images and pricing via the Krova Cloud API.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-node",
    "krova",
    "krova-cloud",
    "cube",
    "cubes",
    "firecracker",
    "microvm",
    "cloud",
    "infrastructure",
    "iaas",
    "vm",
    "server",
    "provisioning",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://krova.cloud/developers",
  "author": {
    "name": "Krova Inc.",
    "email": "support@krova.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krovacloud/krova-node.git",
    "directory": "packages/n8n-node"
  },
  "bugs": {
    "url": "https://github.com/krovacloud/krova-node/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "format": "oxfmt nodes credentials",
    "lint": "eslint nodes credentials package.json",
    "lint:fix": "eslint nodes credentials package.json --fix",
    "test": "node --test",
    "prepublishOnly": "pnpm build && pnpm lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/KrovaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Krova/Krova.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@typescript-eslint/parser": "8.68.0",
    "@typescript-eslint/utils": "8.68.0",
    "eslint": "10.9.1",
    "eslint-plugin-n8n-nodes-base": "2.0.0",
    "jsonc-eslint-parser": "3.3.0",
    "n8n-core": "2.16.1",
    "n8n-workflow": "2.16.0",
    "oxfmt": "0.65.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
